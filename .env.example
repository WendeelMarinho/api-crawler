# Dock Tech Documentation Extractor
DOCK_BASE_URL=https://developers.dock.tech
DOCK_DOCS_PATH=/reference/inicio
DOCK_USERNAME=
DOCK_PASSWORD=

# Crawler settings
CRAWL_CONCURRENCY=5
CRAWL_DELAY_MS=400
CRAWL_MAX_RETRIES=3
CRAWL_TIMEOUT_MS=60000
CRAWL_HEADLESS=true
CRAWL_RESUME=false
CRAWL_DISCOVER_MODE=sidebar
CRAWL_MAX_PAGES=0

# Salvar artefatos de extração DOM-first em storage/debug-extraction/{docId}/
# full.html, screenshot.png, reference-main.html, body-params.{html,json}, headers.json, responses.json, code-examples.json, extraction-meta.json
EXTRACTION_DEBUG_ARTIFACTS=false

# Node heap (VPS 32GB — ajuste conforme necessário)
NODE_MAX_OLD_SPACE_CRAWL=16384
NODE_MAX_OLD_SPACE_REBUILD=8192
NODE_MAX_OLD_SPACE_EXPORT=8192

# Export settings
CHUNK_MAX_TOKENS=512
EMBEDDING_MODEL=text-embedding-3-small

MANUAL_LOGIN_TIMEOUT_SEC=300
LOG_LEVEL=info

# SMTP — Hostinger (nunca commitar senha real)
SMTP_ENABLED=true
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=seu-email@dominio.com
SMTP_PASS=
SMTP_FROM="Dock Extractor <seu-email@dominio.com>"
SMTP_TO=seu-email@dominio.com

# Notificações por e-mail
NOTIFY_ON_START=true
NOTIFY_ON_PROGRESS=true
NOTIFY_PROGRESS_EVERY_PCT=50
NOTIFY_ON_ERROR=true
NOTIFY_ON_COMPLETE=true
NOTIFY_LOG_TAIL_LINES=40

# Após crawl: rebuild JSON + reorganizar pastas automaticamente
POST_CRAWL_AUTO_EXPORT=true
POST_CRAWL_REORGANIZE=true
POST_CRAWL_AUDIT=false

# WSL only
# PLAYWRIGHT_CDP_URL=http://172.x.x.x:9222
